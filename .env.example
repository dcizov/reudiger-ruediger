# Discord application credentials (Developer Portal).
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_LOGIN_ENABLED=true

# Enable deal posting only after configuring the channel and database.
DEALS_ENABLED=true
DISCORD_DEALS_CHANNEL_ID=
DATABASE_URL=postgres://user:password@localhost:5432/deals

# ITAD API key; sent only in the ITAD-API-Key request header.
ITAD_API_KEY=

# Selection and schedule.
DEALS_MODE=top
DEALS_MAX_POSTS=5
DEALS_COOLDOWN_DAYS=7
DEALS_SCHEDULE=0 */6 * * *
DEALS_TIMEZONE=Europe/Berlin

# Relevance defaults (German Steam prices, euros).
DEAL_COUNTRY=DE
DEAL_CURRENCY=EUR
DEAL_MAX_PRICE=60
DEAL_MIN_REGULAR_PRICE=10
DEAL_MIN_DISCOUNT_PERCENT=35
DEAL_MIN_STEAM_REVIEW_COUNT=1000
DEAL_MIN_METACRITIC_SCORE=70
DEAL_INCLUDE_MATURE=false
DEAL_ALLOW_VOUCHERS=false
DEAL_INCLUDED_GENRES=
DEAL_BLOCKED_GENRES=
DEAL_PREFERRED_PUBLISHERS=

# API paging, caching, and conservative Steam appdetails pacing.
ITAD_DEALS_PAGE_SIZE=200
ITAD_MAX_DEAL_PAGES=2
ITAD_STEAM_SHOP_ID=61
ITAD_DEAL_CACHE_TTL_SECONDS=900
STEAM_ENRICHMENT_ENABLED=true
STEAM_CACHE_TTL_SECONDS=604800
STEAM_REQUEST_DELAY_MS=2000
DEAL_CLAIM_LEASE_MS=120000

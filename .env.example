# Discord Bot Credentials
DISCORD_TOKEN="your-discord-bot-token"
DISCORD_CLIENT_ID="your-discord-client-id"
DISCORD_GUILD_ID="your-discord-guild-id"

# Use localhost for local development (when bot runs outside Docker)
DATABASE_URL="postgresql://postgres:password@localhost:5432/sample-bot"

# Or use docker hostname when bot runs inside Docker
# DATABASE_URL="postgresql://postgres:password@sample-bot-postgres:5432/sample-bot"

DATABASE_USER="postgres"
DATABASE_PASSWORD="password" # openssl rand -base64 12 | tr '+/' '-_'
DATABASE_NAME="sample-bot"
DATABASE_PORT="5432"

# API Keys
ITAD_API_KEY="your-itad-api-key"

# Docker Compose and start-dev.sh specific variables
USER_ID="1000"
GROUP_ID="1000"

# Webhook Server
WEBHOOK_PORT="3001"
WEBHOOK_SECRET="your-strong-webhook-secret"
ENABLE_WEBHOOK_SERVER="true"

NODE_ENV="development"
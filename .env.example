# Discord Bot Credentials
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# Database Components
DATABASE_USER=postgres
DATABASE_PASSWORD=your_secure_password_here
DATABASE_NAME=reudiger-ruediger
DATABASE_PORT=5432

# Database URL (Drizzle)
# Use localhost when running bot outside Docker (npm run dev, npm run migrate)
# Docker Compose overrides this to use postgres-db hostname automatically
DATABASE_URL=postgresql://postgres:your_secure_password_here@localhost:5432/reudiger-ruediger

# API Keys
ITAD_API_KEY=
STEAM_API_KEY=

# Steam API Configuration
# Rate limit for Steam API calls (default: 100 calls per minute)
STEAM_RATE_LIMIT_PER_MINUTE=100

# Webhook Server
WEBHOOK_PORT=3001
WEBHOOK_SECRET=
ENABLE_WEBHOOK_SERVER=false

# Logging
LOG_LEVEL=info

# Environment
NODE_ENV=development

# News Service Timeouts (milliseconds)
# Timeout for Steam article image fetching (default: 2000ms)
STEAM_IMAGE_FETCH_TIMEOUT=2000
# Timeout for Wowhead article image fetching (default: 5000ms)
WOWHEAD_IMAGE_FETCH_TIMEOUT=5000

# Discord credentials
DISCORD_TOKEN=""
DISCORD_CLIENT_ID=""
DISCORD_GUILD_ID=""

# ITAD API key
ITAD_API_KEY=""

# Database connection info
DATABASE_URL="postgresql://postgres:password@localhost:5432/sample-bot"

# Docker-only database variables (used by docker-compose.yml for postgres container setup)
# These are NOT validated in src/config.ts - only DATABASE_URL is used by the application
DATABASE_PASSWORD="password" # openssl rand -base64 12
DATABASE_NAME="sample-bot"
DATABASE_PORT=5432

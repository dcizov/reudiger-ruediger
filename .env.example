# Discord Bot Credentials
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# Database - Individual Components (PostgreSQL container)
DATABASE_USER=postgres
DATABASE_PASSWORD=
DATABASE_NAME=sample-bot
DATABASE_PORT=5432

# Database - Full URL (Drizzle)
# Local: @localhost:5432
# Docker: @postgres-db:5432
DATABASE_URL=postgresql://postgres:password@localhost:5432/sample-bot

# API Keys
ITAD_API_KEY=

# Webhook Server
WEBHOOK_PORT=3001
WEBHOOK_SECRET=
ENABLE_WEBHOOK_SERVER=false

# Logging
LOG_LEVEL=info

# Environment
NODE_ENV=development

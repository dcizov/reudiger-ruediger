{
  "name": "discord-typescript-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:db": "docker compose up -d postgres-db",
    "dev:docker": "docker compose up -d",
    "build": "tsc",
    "start": "node dist/index.js",
    "check": "npm run lint && npm run typecheck",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx -r dotenv/config node_modules/.bin/drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "lint": "eslint \"src/**/*.{ts,js}\" --cache",
    "lint:fix": "eslint \"src/**/*.{ts,js}\" --fix --cache",
    "format:check": "prettier --check \"src/**/*.{ts,js,md,mdx}\" --cache --ignore-path .prettierignore",
    "format:write": "prettier --write \"src/**/*.{ts,js,md,mdx}\" --cache --ignore-path .prettierignore",
    "typecheck": "tsc --noEmit",
    "deploy": "tsx src/deploy-commands.ts",
    "prepare": "is-ci || husky"
  },
  "dependencies": {
    "@extractus/feed-extractor": "^7.1.7",
    "body-parser": "^2.2.0",
    "discord.js": "^14.24.2",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.44.7",
    "express": "^5.1.0",
    "glob": "^11.0.3",
    "node-cron": "^4.2.1",
    "postgres": "^3.4.7",
    "winston": "^3.18.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@eslint/js": "^9.39.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.0",
    "@types/body-parser": "^1.19.6",
    "@types/express": "^5.0.5",
    "@types/glob": "^8.1.0",
    "@types/node": "^24.10.0",
    "@types/node-cron": "^3.0.11",
    "@typescript-eslint/eslint-plugin": "^8.46.3",
    "@typescript-eslint/parser": "^8.46.3",
    "drizzle-kit": "^0.31.6",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-drizzle": "^0.2.3",
    "eslint-plugin-prettier": "^5.5.4",
    "husky": "^9.1.7",
    "is-ci": "^4.1.0",
    "lint-staged": "^16.2.6",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3"
  }
}
